root = true

[*]
indent_style = space
indent_size = 2
# Matches Oxfmt's default printWidth. Oxfmt's printWidth takes precedence
# for formatting decisions; this is for editor ruler consistency.
max_line_length = 100
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false
